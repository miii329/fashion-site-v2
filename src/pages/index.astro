								      <div class="meta-title">Lorem Ipsum</div>
								      <div class="meta-list">
								        <span>NEW</span>
								        <span>item</span>
								      </div>
								    </div>
								  </div>
								  <div class="photo-card">
								    <img src="/assets/items3.png" alt="" />
								    <div class="card-meta">
								      <div class="meta-title">reprehenderit in voluptate</div>
