---
import Layout from "../layouts/Layout.astro";


---


<Layout title="ファッション・インテリア">
	<div class="site-root">
		<header class="nav">
			<div class="nav-item">MENU</div>
			<h1>Lorem Ipsum</h1>
			<div class="nav-item">ONLINE SHOP</div>
		</header>

		<main>
			<section class="hero-landing">
				<div class="hero-inner">
					<div class="side-image">
						<img src="/assets/hero_img1.png" alt="left" />
					</div>
					<div class="center-image">
						<img src="/assets/hero_img2.png" alt="center" />
					</div>
					<div class="side-image">
						<img src="/assets/hero_img3.png" alt="right" />
					</div>
				</div>
				<div class="hero-big-text">Lorem Ipsum</div>
				<p class="text-center">consectetur adipisicing elit</p>
			</section>

			<section class="about-concept">
				<div class="container">
					<h2 style="color:var(--muted);font-size:18px;">ABOUT</h2>
					<div class="two-col" style="margin-top:24px">
						<div>
							<div class="media">
							<img src="/assets/about_img.png" alt="about image" />
						</div>
															<div class="ellipse"></div>

<style>
  .ellipse {
    width: 200px;
    height: 100px;
    background: #ff6b6b;
    border-radius: 50%; /* これだけで楕円！ */
  }
</style>
						</div>
						
						<div>
							<h3 class="heading-xl">dolore eu<br/>fugiat nulla</h3>
							<p class="copy">山路を登りながら、こう考えた。智に働けば角が立つ。情に棹させば流される。意地を通せば窮屈だ。とかくに人の世は住みにくい。住みにくさが高じると、安い所へ引き越したくなる。</p>
						</div>
					</div>
				</div>
	
				<div class="container">
					<h2 style="color:var(--muted);font-size:18px;">CONCEPT</h2>
					<div class="two-col" style="margin-top:24px;align-items:center">
						<div>
							<h3 class="heading-xl">dolore eu<br/>fugiat nulla</h3>
							<p class="copy">山路を登りながら、こう考えた。智に働けば角が立つ。情に棹させば流される。意地を通せば窮屈だ。とかくに人の世は住みにくい。住みにくさが高じると、安い所へ引き越したくなる。</p>
						</div>
						<div class="circle-hero">
							<img src="/assets/concept_img.png" alt="concept" style="width:100%;height:100%;object-fit:cover;display:block" />
																						<div class="ellipse"></div>

<style>
  .ellipse {
    width: 200px;
    height: 100px;
    background: #ff6b6b;
    border-radius: 50%; /* これだけで楕円！ */
  }
</style>
						</div>
					</div>
				</div>
			</section>


						<section class="items">
