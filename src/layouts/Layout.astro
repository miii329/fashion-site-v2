---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

import "../styles/global.css";

// Propsとしてページごとに個別のタイトルや画像を受け取れるようにする
const {
  title = "Mioのサイト",
  description = "Mioがデザインしたファッションとインテリアの世界をご紹介します。",
  ogImage = "/ogp-image.png", // public直下の画像
} = Astro.props;

// 絶対URLを生成（OGP画像は絶対URLである必要があります）
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="ファッション・インテリアのウェブサイト" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="ファッション,インテリア,デザイン" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="ファッション・インテリアのウェブサイト"
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");
      @import url("https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap");

      /* Remove list markers */
      .follow-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 20px;
      }

      .follow-col {
        margin: 0;
      }

      .follow-col img {
        width: 285px;
        height: 380px;
        object-fit: cover;
        display: block;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
